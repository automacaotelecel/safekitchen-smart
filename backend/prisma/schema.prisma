generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  document           String?
  logoUrl            String?
  timezone           String    @default("America/Sao_Paulo")
  plan               String    @default("TRIAL")
  subscriptionStatus String    @default("TRIALING")
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  maxUsers           Int       @default(5)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users               User[]
  employees           Employee[]
  products            Product[]
  labels              Label[]
  documents           Document[]
  temperaturePoints   TemperaturePoint[]
  temperatureDevices  TemperatureDevice[]
  temperatureReadings TemperatureReading[]
  complianceRecords   ComplianceRecord[]
  auditLogs           AuditLog[]
  aiUsage             AiUsage[]
  subscription        Subscription?
  kitOrders           KitOrder[]
  contracts           CommercialContract[]
  paymentEvents       PaymentEvent[]
  notifications       Notification[]

  @@index([subscriptionStatus])
  @@index([active])
}

model User {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  documents           Document[]
  temperatureReadings TemperatureReading[]
  complianceRecords   ComplianceRecord[]
  auditLogs           AuditLog[]
  aiUsage             AiUsage[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
  acceptedContracts      CommercialContract[]

  @@index([restaurantId])
  @@index([restaurantId, active])
}

model Employee {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  role         String?
  shift        String?
  phone        String?
  email        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  labels     Label[]

  @@index([restaurantId])
  @@index([restaurantId, active])
}

model Product {
  id           String   @id @default(cuid())
  restaurantId String?
  name         String
  category     String
  imageUrl     String?
  defaultMode  String
  keywords     String   @default("")
  isGlobal     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  validityRules ValidityRule[]
  labels        Label[]

  @@index([restaurantId])
  @@index([name])
  @@index([category])
  @@index([active])
}

model ValidityRule {
  id               String   @id @default(cuid())
  productId        String?
  category         String
  description      String
  conservationMode String
  validityValue    Int
  validityUnit     String   @default("days")
  source           String   @default("Tabela técnica configurável")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([category])
  @@index([conservationMode])
}

model Label {
  id               String    @id @default(cuid())
  restaurantId     String
  productId        String?
  employeeId       String?
  type             String
  productName      String
  brand            String?
  supplier         String?
  batch            String?
  conservationMode String
  openedAt         DateTime
  expiresAt        DateTime?
  quantity         String?
  responsibleName  String
  observations     String?
  extraData        String?
  status           String    @default("ATIVA")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([productId])
  @@index([employeeId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([restaurantId, status, expiresAt])
}

model Document {
  id           String    @id @default(cuid())
  restaurantId String
  uploadedById String
  name         String
  category     String
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  storageKey   String?   @unique
  externalUrl  String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  reminderDays Int       @default(30)
  notes        String?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([restaurantId, status])
  @@index([restaurantId, expiresAt])
  @@index([category])
}

model TemperaturePoint {
  id             String   @id @default(cuid())
  restaurantId   String
  name           String
  category       String
  minTemperature Float?
  maxTemperature Float?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  devices    TemperatureDevice[]
  readings   TemperatureReading[]

  @@unique([restaurantId, name, category])
  @@index([restaurantId, active])
}

model TemperatureDevice {
  id           String    @id @default(cuid())
  restaurantId String
  pointId      String?
  name         String
  externalId   String?
  protocol     String    @default("API")
  apiKeyHash   String?
  active       Boolean   @default(true)
  lastSeenAt   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  point      TemperaturePoint?    @relation(fields: [pointId], references: [id], onDelete: SetNull)
  readings   TemperatureReading[]

  @@unique([restaurantId, externalId])
  @@index([restaurantId, active])
  @@index([pointId])
}

model TemperatureReading {
  id                    String   @id @default(cuid())
  restaurantId          String
  pointId               String?
  deviceId              String?
  createdById           String?
  category              String
  subject               String
  temperatureC          Float
  secondaryTemperatureC Float?
  tertiaryTemperatureC  Float?
  occurredAt            DateTime
  source                String   @default("MANUAL")
  status                String   @default("NORMAL")
  responsibleName       String
  notes                 String?
  metadata              Json?
  createdAt             DateTime @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  point      TemperaturePoint?  @relation(fields: [pointId], references: [id], onDelete: SetNull)
  device     TemperatureDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([restaurantId, occurredAt])
  @@index([restaurantId, category, occurredAt])
  @@index([restaurantId, status, occurredAt])
  @@index([pointId, occurredAt])
  @@index([deviceId, occurredAt])
}

model ComplianceRecord {
  id              String    @id @default(cuid())
  restaurantId    String
  createdById     String
  type            String
  subject         String
  occurredAt      DateTime
  nextDueAt       DateTime?
  responsibleName String
  notes           String?
  data            Json?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([restaurantId, type, occurredAt])
  @@index([restaurantId, status, nextDueAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String?
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([entity, entityId])
}

model AiUsage {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String?
  feature      String
  model        String
  success      Boolean
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, feature, createdAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  restaurantId           String    @unique
  provider               String    @default("MERCADO_PAGO")
  planCode               String
  status                 String    @default("PENDING")
  providerSubscriptionId String?   @unique
  payerEmail             String?
  checkoutUrl            String?
  amountCents            Int
  currency               String    @default("BRL")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerSubscriptionId])
}

model KitOrder {
  id                   String    @id @default(cuid())
  restaurantId         String
  planCode             String
  status               String    @default("PENDING")
  provider              String    @default("MERCADO_PAGO")
  providerPreferenceId String?   @unique
  providerPaymentId    String?   @unique
  checkoutUrl          String?
  amountCents          Int
  currency             String    @default("BRL")
  payerEmail           String
  customerName         String
  customerDocument     String
  customerPhone        String?
  deliveryAddress      Json
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  contract   CommercialContract?

  @@index([restaurantId, status, createdAt])
  @@index([providerPaymentId])
}

model CommercialContract {
  id                 String    @id @default(cuid())
  restaurantId       String
  kitOrderId         String    @unique
  acceptedById       String
  contractNumber     String    @unique
  version            String
  status             String    @default("ACCEPTED_PENDING_PAYMENT")
  customerName       String
  customerEmail      String
  customerDocument   String
  customerPhone      String?
  planCode           String
  setupAmountCents   Int
  monthlyAmountCents Int
  currency           String    @default("BRL")
  termsSnapshot      Json
  contentHash        String
  acceptedAt         DateTime
  acceptedIp         String?
  acceptedUserAgent  String?
  activatedAt        DateTime?
  emailedAt          DateTime?
  emailProviderId    String?
  emailError         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kitOrder   KitOrder   @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)
  acceptedBy User       @relation(fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([restaurantId, status, createdAt])
  @@index([customerEmail])
}

model PaymentEvent {
  id                String    @id @default(cuid())
  restaurantId      String?
  provider          String    @default("MERCADO_PAGO")
  providerEventId   String    @unique
  eventType         String
  resourceId        String?
  payload           Json?
  processedAt       DateTime?
  processingError   String?
  createdAt         DateTime  @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([eventType, createdAt])
}

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  inAppEnabled             Boolean  @default(true)
  emailEnabled             Boolean  @default(true)
  labelsEnabled            Boolean  @default(true)
  documentsEnabled         Boolean  @default(true)
  complianceEnabled        Boolean  @default(true)
  temperatureEnabled       Boolean  @default(true)
  deviceOfflineEnabled     Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String    @id @default(cuid())
  restaurantId   String
  userId         String
  type           String
  severity       String    @default("INFO")
  title          String
  message        String
  link           String?
  entity         String?
  entityId       String?
  dedupeKey      String
  readAt         DateTime?
  emailSentAt    DateTime?
  emailAttempts  Int       @default(0)
  emailError     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([restaurantId, createdAt])
  @@index([emailSentAt, emailAttempts])
}
