NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safekitchen?schema=public"
JWT_SECRET="troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres"
PORT=3333
FRONTEND_URL="http://localhost:5174"
BACKEND_URL="http://localhost:3333"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite"
AI_TIMEOUT_MS=45000
MAX_IMAGE_BYTES=6000000

# Armazenamento S3 compatível (AWS S3, Cloudflare R2, Backblaze B2 ou MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false
MAX_DOCUMENT_BYTES=20971520

# Cobrança de implantação + recorrência pelo Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
PLAN_START_SETUP_PRICE=990.00
PLAN_START_MONTHLY_PRICE=197.00
PLAN_PRO_SETUP_PRICE=3700.00
PLAN_PRO_MONTHLY_PRICE=497.00

# Dados jurídicos usados no contrato PDF
CONTRACT_PROVIDER_NAME="Razão social da fornecedora"
CONTRACT_PROVIDER_DOCUMENT="00.000.000/0001-00"
CONTRACT_PROVIDER_ADDRESS="Endereço completo"
CONTRACT_PROVIDER_EMAIL="contratos@safekitchensmart.com.br"
CONTRACT_CITY="Cidade/UF"
CONTRACT_TERMS_VERSION="2026-07-22"
CONTRACT_DELIVERY_DAYS=15

# Alertas por e-mail (Resend) e execução agendada
RESEND_API_KEY=""
EMAIL_FROM="SafeKitchen Smart <alertas@safekitchensmart.com.br>"
ALERT_JOB_SECRET="troque-por-uma-chave-aleatoria"
ALERT_INTERVAL_MINUTES=30
DEVICE_OFFLINE_MINUTES=60

# Somente para ambiente local de demonstração
SEED_DEMO_USER=false
SEED_DEMO_PASSWORD=""
