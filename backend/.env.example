NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safekitchen?schema=public"
JWT_SECRET="troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres"
PORT=3333
FRONTEND_URL="http://localhost:5174"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite"
AI_TIMEOUT_MS=45000
MAX_IMAGE_BYTES=6000000

# Armazenamento S3 compatível (AWS S3, Cloudflare R2, Backblaze B2 ou MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false
MAX_DOCUMENT_BYTES=20971520

# Somente para ambiente local de demonstração
SEED_DEMO_USER=false
SEED_DEMO_PASSWORD=""
